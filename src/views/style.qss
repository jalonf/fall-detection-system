/* ============================================================
   CARE CONSOLE THEME  ·  soft blue on white, blue-grey neutrals
   Red is reserved for alerts. One radius scale, one border colour.

   Tokens
     primary       #3D6FBE   hover #3361A9   pressed #2B5290
     primary-soft  #EEF3FB   soft-strong #E2EBF8   line #C8D8EF
     canvas        #F4F6FA   surface #FFFFFF   alt #F8FAFC
     border        #E1E6EF   control #CBD3E1   hover #AEB9CE
     text          #1E293B   body #475569   muted #64748B   subtle #94A3B8
     success       #2E8A68   warning #B7791F   danger #D43D3D
     radius        controls 10 · panels 14 · chips pill
   ============================================================ */

* {
    font-family: "Segoe UI", "Inter", "SF Pro Text", "Helvetica Neue", "Roboto", sans-serif;
}

QMainWindow,
QWidget#monitorScreen,
QWidget#adminScreen,
QWidget#monitorBody {
    background-color: #F4F6FA;
}

QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 9px;
    font-size: 12px;
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */
QLabel {
    background: transparent;
    color: #475569;
    font-size: 13px;
}

QLabel#cardTitle    { font-size: 16px; font-weight: 700; color: #1E293B; }
QLabel#cardSubtitle { font-size: 12px; color: #64748B; }
QLabel#fieldLabel   { font-size: 12px; font-weight: 600; color: #334155; }
QLabel#sectionTitle { font-size: 13px; font-weight: 700; color: #1E293B; }
QLabel#detectionDetail { font-size: 12px; color: #64748B; }

QLabel#streamMeta {
    font-family: "Cascadia Mono", "SF Mono", "Consolas", "Menlo", monospace;
    font-size: 11px;
    color: #94A3B8;
}

QFrame#divider {
    background-color: #E1E6EF;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ============================================================
   AUTH SCREEN  (brand surface and form share one light language)
   ============================================================ */
QWidget#authScreen { background-color: #FFFFFF; }

QWidget#authScreen QStackedWidget,
QWidget#authPage {
    background: transparent;
}

QScrollArea#authScroll,
QScrollArea#authScroll > QWidget,
QScrollArea#authScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#authPanel {
    background-color: #FFFFFF;
    border: none;
    border-left: 1px solid #E1E6EF;
}

QLabel#authBrandMark {
    background-color: transparent;
    color: #FFFFFF;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 800;
}
QLabel#authBrandName { 
    font-size: 32px; 
    font-weight: 800; 
    color: #1E293B; 
}
QLabel#brandHeadline { font-size: 30px; font-weight: 700; color: #1E293B; }
QLabel#brandDesc     { font-size: 14px; color: #475569; }
QLabel#techPill {
    background-color: #FFFFFF;
    border: 1px solid #D5DFEF;
    border-radius: 15px;
    color: #475569;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#formTitle    { font-size: 30px; font-weight: 800; color: #1E293B; }
QLabel#formSubtitle { font-size: 14px; color: #64748B; }

QLabel#stepTitle   { font-size: 16px; font-weight: 700; color: #1E293B; }
QLabel#stepCounter { font-size: 12px; font-weight: 600; color: #64748B; }
QLabel#stepHint    { font-size: 13px; color: #64748B; }

QFrame#stepBar { border: none; border-radius: 2px; background-color: #E1E6EF; }
QFrame#stepBar[state="done"]    { background-color: #9DB9E6; }
QFrame#stepBar[state="current"] { background-color: #3D6FBE; }
QLabel#formSection  { font-size: 12px; font-weight: 700; color: #3D6FBE; }
QLabel#authHint     { font-size: 13px; color: #64748B; }
QLabel#authFooter   { font-size: 11px; color: #94A3B8; }

QLabel#link       { font-size: 13px; font-weight: 700; color: #3D6FBE; }
QLabel#link:hover { color: #2B5290; text-decoration: underline; }

QLabel#fieldMessage[kind="help"]  { font-size: 11px; color: #64748B; }
QLabel#fieldMessage[kind="error"] { font-size: 11px; color: #D43D3D; }

/* ============================================================
   TOPBAR  (light, shares the white surface language of the panels)
   ============================================================ */
QFrame#topbar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E1E6EF;
}

QLabel#brandMark {
    background-color: #3D6FBE;
    color: #FFFFFF;
    border-radius: 9px;
    font-size: 16px;
    font-weight: 800;
}

QFrame#topbar QLabel#appTitle    { font-size: 18px; font-weight: 800; color: #1E293B; }
QFrame#topbar QLabel#appSubtitle { font-size: 13px; color: #64748B; }

QFrame#topbarSep { background-color: #E1E6EF; border: none; }

QLabel#avatar {
    background-color: #E2EBF8;
    color: #2B5290;
    border-radius: 20px; 
    font-size: 15px;
    font-weight: 700;
}
QFrame#topbar QLabel#userName { font-size: 15px; font-weight: 700; color: #1E293B; }
QFrame#topbar QLabel#userRole { font-size: 12px; color: #64748B; }

/* ============================================================
   PANELS & CARDS
   ============================================================ */
QFrame#panel {
    background-color: #FFFFFF;
    border: 1px solid #E1E6EF;
    border-radius: 14px;
}

QFrame#statusCard {
    background-color: #FFFFFF;
    border: 1px solid #E1E6EF;
    border-radius: 14px;
}
QFrame#statusCard[state="alert"] {
    background-color: #FDF1F1;
    border: 1px solid #F3BFBF;
}
QFrame#statusCard[state="alert"][pulse="on"] {
    border: 1px solid #D43D3D;
}

QFrame#statusDot { border: none; border-radius: 4px; background-color: #94A3B8; }
QFrame#statusDot[state="active"] { background-color: #3D6FBE; }
QFrame#statusDot[state="alert"]  { background-color: #B93030; }
QFrame#statusDot[state="alert"][pulse="on"] { background-color: #D43D3D; }

QLabel#detectionStatus { font-size: 13px; font-weight: 600; color: #64748B; }
QLabel#detectionStatus[state="active"] { color: #3361A9; }
QLabel#detectionStatus[state="alert"]  { color: #B93030; font-weight: 700; }
QLabel#detectionStatus[state="alert"][pulse="on"] { color: #D43D3D; }

QLabel#detectionDetail[state="alert"] { color: #922626; }

/* ============================================================
   VIDEO / TELEMETRY STAGE
   ============================================================ */
QFrame#stage {
    background-color: #0F1B2D;
    border: 2px solid #243249;
    border-radius: 12px;
}
QFrame#stage[alert="on"]  { border: 2px solid #E24B4B; }
QFrame#stage[alert="dim"] { border: 2px solid #8C3A3A; }

QLabel#videoFrame { background: transparent; color: #8A9CC0; }

QLabel#poseView {
    background-color: #0F1B2D;
    color: #7F90B4;
    font-size: 12px;
    border-radius: 8px;
}

QFrame#fallBanner {
    background-color: #D43D3D;
    border: 1px solid #B93030;
    border-radius: 11px;
}
QFrame#fallBanner[pulse="on"] {
    background-color: #E24B4B;
    border: 1px solid #D43D3D;
}
QLabel#fallBannerText { font-size: 13px; font-weight: 700; color: #FFFFFF; }

QLabel#metricCaption { font-size: 11px; color: #94A3B8; }
QLabel#metricValue {
    font-family: "Cascadia Mono", "SF Mono", "Consolas", "Menlo", monospace;
    font-size: 14px;
    font-weight: 600;
    color: #1E293B;
}

QProgressBar#confBar {
    background-color: #E8ECF3;
    border: none;
    border-radius: 2px;
}
QProgressBar#confBar::chunk {
    background-color: #3D6FBE;
    border-radius: 2px;
}

/* ============================================================
   STATUS CHIP  (idle · active · alert)
   ============================================================ */
QFrame#statusChip { border-radius: 14px; }
QLabel#chipText   { font-size: 12px; font-weight: 600; }
QFrame#chipDot    { border: none; border-radius: 4px; }

QFrame#statusChip[state="idle"]   { background-color: #F8FAFC; border: 1px solid #E1E6EF; }
QFrame#statusChip[state="active"] { background-color: #EEF3FB; border: 1px solid #C8D8EF; }
QFrame#statusChip[state="alert"]  { background-color: #FDF1F1; border: 1px solid #F3BFBF; }

QFrame#chipDot[state="idle"]   { background-color: #94A3B8; }
QFrame#chipDot[state="active"] { background-color: #3D6FBE; }
QFrame#chipDot[state="alert"]  { background-color: #D43D3D; }

QLabel#chipText[state="idle"]   { color: #64748B; }
QLabel#chipText[state="active"] { color: #2B5290; }
QLabel#chipText[state="alert"]  { color: #B93030; }

/* ============================================================
   TOAST  (routine notifications — white, discreet, tinted icon only)
   ============================================================ */
QFrame#toast {
    background-color: #FFFFFF;
    border: 1px solid #E1E6EF;
    border-radius: 14px;
}
QLabel#toastIcon { border-radius: 16px; }
QLabel#toastIcon[kind="success"] { background-color: #EAF6F1; }
QLabel#toastIcon[kind="info"]    { background-color: #EEF3FB; }
QLabel#toastIcon[kind="warning"] { background-color: #FEF7E8; }
QLabel#toastIcon[kind="error"]   { background-color: #FDF1F1; }

QLabel#toastTitle   { font-size: 13px; font-weight: 700; color: #1E293B; }
QLabel#toastMessage { font-size: 12px; color: #64748B; }

QPushButton#toastClose {
    background-color: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}
QPushButton#toastClose:hover { background-color: #EEF1F6; }

/* ============================================================
   BUTTONS
   ============================================================ */
QPushButton {
    background-color: #3D6FBE;
    color: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primary { background-color: #3D6FBE; }
QPushButton#primary:hover   { background-color: #3361A9; }
QPushButton#primary:pressed { background-color: #2B5290; }
QPushButton#primary:disabled { background-color: #E8ECF3; color: #94A3B8; }

QPushButton#danger { background-color: #D43D3D; }
QPushButton#danger:hover   { background-color: #B93030; }
QPushButton#danger:pressed { background-color: #9F2A2A; }
QPushButton#danger:disabled { background-color: #E8ECF3; color: #94A3B8; }

QPushButton#ghost {
    background-color: #FFFFFF;
    color: #3361A9;
    border: 1px solid #CBD3E1;
}
QPushButton#ghost:hover {
    background-color: #EEF3FB;
    border-color: #A9C0E6;
}
QPushButton#ghost:pressed { background-color: #E2EBF8; }
QPushButton#ghost:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1px solid #E1E6EF;
}

QPushButton#quiet {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
    padding: 0 12px;
}
QPushButton#quiet:hover   { background-color: #EEF3FB; color: #2B5290; }
QPushButton#quiet:pressed { background-color: #E2EBF8; }

QPushButton#subtle {
    background-color: transparent;
    color: #64748B;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 0 6px;
}
QPushButton#subtle:hover { color: #3D6FBE; }

/* ============================================================
   INPUTS & SELECTS
   ============================================================ */
QLineEdit, QComboBox {
    background-color: #F8FAFC;
    border: 1px solid #D3DAE6;
    border-radius: 10px;
    padding: 0 12px;
    font-size: 13px;
    color: #1E293B;
    selection-background-color: #C8D8EF;
    selection-color: #1E293B;
}
QLineEdit:hover, QComboBox:hover {
    border-color: #AEB9CE;
}
QLineEdit:focus, QComboBox:focus {
    background-color: #FFFFFF;
    border: 2px solid #3D6FBE;
    padding: 0 11px;
}
QLineEdit[invalid="true"] {
    background-color: #FFFBFB;
    border: 1px solid #D43D3D;
}
QLineEdit[invalid="true"]:focus {
    border: 2px solid #D43D3D;
    padding: 0 11px;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #F1F4F9;
    color: #94A3B8;
    border-color: #E1E6EF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
}
QComboBox::down-arrow {
    image: url("@ASSETS@/chevron-down.svg");
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD3E1;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #EEF3FB;
    selection-color: #1E293B;
}

/* ============================================================
   EVENT LOG (rows are painted by a custom delegate)
   ============================================================ */
QListWidget#eventLog {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ============================================================
   SCROLLBARS
   ============================================================ */
QScrollArea { background: transparent; border: none; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #CBD3E1; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #AEB9CE; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #CBD3E1; border-radius: 3px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #AEB9CE; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }