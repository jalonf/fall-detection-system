/* ============================================================
   INSTRUMENT PANEL THEME

   Cool white surfaces on a pale blue-grey canvas, one deep instrument blue for
   everything interactive, hairline borders and near-square corners. Red appears
   only when something is wrong. The video well is a soft charcoal.

   This file contains NO literal colours. Every value written between two
   at-signs is replaced at load time by ThemeManager (src/views/theme.py),
   which is the single source of truth for colours, radii and font stacks.
   To re-skin the app, edit the Colors / Radius / Fonts classes there.

   Scales
     radius   SM 4 (tags, chips) · MD 6 (controls, stage) · LG 8 (panels)
     type     11 caption · 12 small · 13 body · 14 lead · 15 title · 24 display
     weight   400 body · 600 labels, values and headings
     states   every interactive element defines :hover, :pressed, :focus and
              :disabled (and :checked where it can be toggled).
   ============================================================ */

* {
    font-family: @FONT_UI@;
}

QMainWindow,
QWidget#authScreen,
QWidget#monitorScreen,
QWidget#adminScreen,
QWidget#monitorBody {
    background-color: @BACKGROUND@;
}

QToolTip {
    background-color: @CHROME@;
    color: @TEXT_MAIN@;
    border: 1px solid @CHROME_BORDER@;
    border-radius: @RADIUS_SM@;
    padding: 6px 9px;
    font-size: 12px;
}

/* ============================================================
   TYPOGRAPHY
   ============================================================ */
QLabel {
    background: transparent;
    color: @TEXT_BODY@;
    font-size: 13px;
}

QLabel#cardTitle    { font-family: @FONT_DISPLAY@; font-size: 16px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#cardSubtitle { font-size: 12px; color: @TEXT_MUTED@; }
QLabel#sectionTitle { font-family: @FONT_DISPLAY@; font-size: 14px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#fieldLabel   { font-size: 12px; font-weight: 600; color: @TEXT_LABEL@; }

QLabel#metricCaption { font-size: 11px; color: @TEXT_SUBTLE@; }
QLabel#metricValue {
    font-family: @FONT_MONO@;
    font-size: 14px;
    font-weight: 600;
    color: @TEXT_MAIN@;
}
QLabel#metricValue[empty="true"] { color: @TEXT_SUBTLE@; font-weight: 400; }

/* ============================================================
   WORDMARK  (typographic only: a short accent bar and the application name)
   ============================================================ */
QFrame#wordmarkBar     { background-color: @PRIMARY@; border: none; border-radius: 1px; }
QLabel#wordmark        { font-family: @FONT_DISPLAY@; font-size: 16px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#wordmarkLarge   { font-family: @FONT_DISPLAY@; font-size: 22px; font-weight: 600; color: @TEXT_MAIN@; }
QFrame#wordmarkDivider { background-color: @BORDER_STRONG@; border: none; }
QLabel#wordmarkCaption { font-size: 12px; color: @TEXT_MUTED@; }

/* ============================================================
   AUTH SCREEN
   Left: brand surface painted by PoseBackdrop. Right: a floating form card.
   ============================================================ */
QWidget#authRight,
QWidget#brandPanel,
QWidget#authPage,
QWidget#authScreen QStackedWidget {
    background: transparent;
}

QScrollArea#authScroll,
QScrollArea#authScroll > QWidget,
QScrollArea#authScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

QFrame#authShadow {
    background-color: @SURFACE@;
    border: none;
    border-radius: @RADIUS_LG@;
}

QFrame#authCard {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @RADIUS_LG@;
}

QLabel#brandHeadline { font-family: @FONT_DISPLAY@; font-size: 28px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#brandDesc     { font-size: 14px; color: @TEXT_BODY@; }
QLabel#techPill {
    background-color: @SURFACE@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: @RADIUS_SM@;
    color: @TEXT_MUTED@;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QLabel#formTitle    { font-family: @FONT_DISPLAY@; font-size: 24px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#formSubtitle { font-size: 14px; color: @TEXT_MUTED@; }

QLabel#stepTitle   { font-family: @FONT_DISPLAY@; font-size: 15px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#stepCounter { font-size: 12px; font-weight: 600; color: @TEXT_MUTED@; }
QLabel#stepHint    { font-size: 13px; color: @TEXT_MUTED@; }

QFrame#stepBar { border: none; border-radius: 1px; background-color: @TRACK@; }
QFrame#stepBar[state="done"]    { background-color: @PRIMARY_BORDER@; }
QFrame#stepBar[state="current"] { background-color: @PRIMARY@; }

QLabel#authHint   { font-size: 13px; color: @TEXT_MUTED@; }
QLabel#authFooter { font-size: 11px; color: @TEXT_SUBTLE@; }

QLabel#fieldMessage[kind="help"]  { font-size: 11px; color: @TEXT_MUTED@; }
QLabel#fieldMessage[kind="error"] { font-size: 11px; color: @DANGER_TEXT@; }

/* ============================================================
   TOPBAR  (white header; a 2px rail along its bottom edge mirrors the system state)
   ============================================================ */
QFrame#topbar { background-color: @SURFACE@; border: none; }


QFrame#topbarSep { background-color: @BORDER@; border: none; }

QLabel#clock { font-family: @FONT_MONO@; font-size: 12px; color: @TEXT_MUTED@; }

QLabel#avatar {
    background-color: @PRIMARY_SOFT@;
    border: 1px solid @PRIMARY_BORDER@;
    color: @PRIMARY@;
    border-radius: @RADIUS_MD@;
    font-size: 13px;
    font-weight: 600;
}
QFrame#topbar QLabel#userName { font-size: 13px; font-weight: 600; color: @TEXT_MAIN@; }
QFrame#topbar QLabel#userRole { font-size: 12px; color: @TEXT_MUTED@; }

/* ============================================================
   PANELS & CARDS  (one surface, one hairline, one radius)
   ============================================================ */
QFrame#panel,
QFrame#statusCard {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: @RADIUS_LG@;
}

QFrame#statusCard[state="alert"] {
    background-color: @DANGER_SOFT@;
    border: 1px solid @DANGER_BORDER@;
}
QFrame#statusCard[state="alert"][pulse="on"] {
    border: 1px solid @DANGER@;
}

QFrame#statusDot { border: none; border-radius: 4px; background-color: @TEXT_SUBTLE@; }
QFrame#statusDot[state="active"] { background-color: @PRIMARY@; }
QFrame#statusDot[state="alert"]  { background-color: @DANGER@; }
QFrame#statusDot[state="alert"][pulse="on"] { background-color: @DANGER_PULSE@; }

QLabel#detectionStatus { font-size: 13px; font-weight: 600; color: @TEXT_MUTED@; }
QLabel#detectionStatus[state="active"] { color: @PRIMARY@; }
QLabel#detectionStatus[state="alert"]  { color: @DANGER_TEXT@; font-weight: 600; }
QLabel#detectionStatus[state="alert"][pulse="on"] { color: @DANGER_PULSE@; }

QLabel#detectionDetail { font-size: 12px; color: @TEXT_MUTED@; }
QLabel#detectionDetail[state="alert"] { color: @DANGER_TEXT@; }

/* ============================================================
   VIDEO STAGE & TELEMETRY
   The border is always 2px so the alert pulse never shifts the layout.
   ============================================================ */
QFrame#stage {
    background-color: @STAGE@;
    border: 2px solid @STAGE_BORDER@;
    border-radius: @RADIUS_MD@;
}
QFrame#stage[alert="on"]  { border: 2px solid @DANGER_PULSE@; }
QFrame#stage[alert="dim"] { border: 2px solid @DANGER_DIM@; }

QLabel#videoFrame { background: transparent; }

/* "Stream offline" empty state, drawn on the charcoal stage */
QWidget#streamPlaceholder { background: transparent; }
QLabel#placeholderTitle   { font-family: @FONT_DISPLAY@; font-size: 15px; font-weight: 600; color: @STAGE_TEXT@; }
QLabel#placeholderHint    { font-size: 13px; color: @STAGE_TEXT_MUTED@; }

QLabel#poseView {
    background-color: @STAGE@;
    color: @STAGE_TEXT_MUTED@;
    font-size: 12px;
    border-radius: @RADIUS_SM@;
}

QFrame#fallBanner {
    background-color: @DANGER_SOLID@;
    border: 1px solid @DANGER@;
    border-radius: @RADIUS_MD@;
}
QFrame#fallBanner[pulse="on"] {
    background-color: @DANGER_SOLID_HOVER@;
    border: 1px solid @DANGER_PULSE@;
}
QLabel#fallBannerText { font-size: 13px; font-weight: 600; color: @TEXT_INVERSE@; }

QProgressBar#confBar {
    background-color: @TRACK@;
    border: none;
    border-radius: 2px;
}
QProgressBar#confBar::chunk {
    background-color: @PRIMARY@;
    border-radius: 2px;
}

/* ============================================================
   STATUS CHIP  (idle · active · alert)
   ============================================================ */
QFrame#statusChip { border-radius: @RADIUS_SM@; }   /* tag, not pill */
QLabel#chipText   { font-size: 12px; font-weight: 600; }
QFrame#chipDot    { border: none; border-radius: 4px; }

QFrame#statusChip[state="idle"]   { background-color: @SURFACE_ALT@;      border: 1px solid @BORDER@; }
QFrame#statusChip[state="active"] { background-color: @PRIMARY_SOFT@;     border: 1px solid @PRIMARY_BORDER@; }
QFrame#statusChip[state="alert"]  { background-color: @DANGER_SOFT@;      border: 1px solid @DANGER_BORDER@; }

QFrame#chipDot[state="idle"]   { background-color: @TEXT_SUBTLE@; }
QFrame#chipDot[state="active"] { background-color: @PRIMARY@; }
QFrame#chipDot[state="alert"]  { background-color: @DANGER@; }

QLabel#chipText[state="idle"]   { color: @TEXT_MUTED@; }
QLabel#chipText[state="active"] { color: @PRIMARY@; }
QLabel#chipText[state="alert"]  { color: @DANGER_TEXT@; }

/* ============================================================
   TOAST  (floating, one step above the panels)
   ============================================================ */
QFrame#toast {
    background-color: @SURFACE_RAISED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: @RADIUS_LG@;
}
QLabel#toastIcon { border-radius: @RADIUS_MD@; }
QLabel#toastIcon[kind="success"] { background-color: @SUCCESS_SOFT@; }
QLabel#toastIcon[kind="info"]    { background-color: @INFO_SOFT@; }
QLabel#toastIcon[kind="warning"] { background-color: @WARNING_SOFT@; }
QLabel#toastIcon[kind="error"]   { background-color: @DANGER_SOFT@; }

QLabel#toastTitle   { font-size: 13px; font-weight: 600; color: @TEXT_MAIN@; }
QLabel#toastMessage { font-size: 12px; color: @TEXT_BODY@; }

QPushButton#toastClose {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @RADIUS_SM@;
    padding: 0;
}
QPushButton#toastClose:hover   { background-color: @TRACK@; }
QPushButton#toastClose:pressed { background-color: @BORDER@; }
QPushButton#toastClose:focus   { border-color: @PRIMARY@; }

/* ============================================================
   BUTTONS  (primary · danger · ghost · subtle · link)
   Filled buttons carry a barely-there top-to-bottom gradient and a darker 1px edge so
   they read as pressable controls. Label and icon colours match in every state (see
   icons.icon()). Focus is always visible for keyboard users: a 2px ring, with the
   padding reduced by 1px so nothing moves.
   ============================================================ */
QPushButton {
    background-color: @PRIMARY@;
    color: @ON_PRIMARY@;
    border: 1px solid @PRIMARY_EDGE@;
    border-radius: @RADIUS_MD@;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primary {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @PRIMARY_TOP@, stop:1 @PRIMARY@);
    color: @ON_PRIMARY@;
    border: 1px solid @PRIMARY_EDGE@;
}
QPushButton#primary:hover   { background-color: @PRIMARY_HOVER@; }
QPushButton#primary:pressed { background-color: @PRIMARY_PRESSED@; }
QPushButton#primary:checked { background-color: @PRIMARY_PRESSED@; }
QPushButton#primary:focus   { border: 2px solid @ACCENT@; padding: 0 15px; }
QPushButton#primary:disabled { background-color: @FIELD_DISABLED@; color: @TEXT_SUBTLE@; border: 1px solid @BORDER@; }

/* Start / stop toggle: light grey while idle, red while a stream is running. */
QPushButton#toggle {
    background-color: @TRACK@;
    color: @TEXT_MAIN@;
    border: 1px solid @BORDER_STRONG@;
}
QPushButton#toggle:hover   { background-color: @BORDER@; }
QPushButton#toggle:pressed { background-color: @BORDER_STRONG@; }
QPushButton#toggle:focus   { border: 2px solid @PRIMARY@; padding: 0 15px; }
QPushButton#toggle[running="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @DANGER_TOP@, stop:1 @DANGER_SOLID@);
    color: @TEXT_INVERSE@;
    border: 1px solid @DANGER_SOLID_PRESSED@;
}
QPushButton#toggle[running="true"]:hover   { background-color: @DANGER_SOLID_HOVER@; }
QPushButton#toggle[running="true"]:pressed { background-color: @DANGER_SOLID_PRESSED@; }
QPushButton#toggle[running="true"]:focus   { border: 2px solid @DANGER_BORDER@; padding: 0 15px; }

QPushButton#ghost {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @SURFACE@, stop:1 @SURFACE_ALT@);
    color: @ON_GHOST@;
    border: 1px solid @BORDER_STRONG@;
}
QPushButton#ghost:hover   { background-color: @HOVER_TINT@; border-color: @BORDER_HOVER@; }
QPushButton#ghost:pressed { background-color: @TRACK@; }
QPushButton#ghost:checked { background-color: @PRIMARY_SOFT_STRONG@; border-color: @PRIMARY_BORDER@; color: @PRIMARY@; }
QPushButton#ghost:focus   { border: 2px solid @PRIMARY@; padding: 0 15px; }
QPushButton#ghost:disabled {
    background-color: @SURFACE_ALT@;
    color: @TEXT_SUBTLE@;
    border: 1px solid @BORDER@;
}

/* Segmented pair: two ghost buttons joined into one control */
QPushButton#ghost[segment="first"] { border-top-right-radius: 0; border-bottom-right-radius: 0; }
QPushButton#ghost[segment="last"]  { border-top-left-radius: 0;  border-bottom-left-radius: 0; border-left-width: 0; }
QPushButton#ghost[segment="last"]:focus { border-left-width: 2px; }

QPushButton#subtle {
    background-color: transparent;
    color: @TEXT_MUTED@;
    border: 1px solid transparent;
    font-size: 12px;
    font-weight: 600;
    padding: 0 8px;
}
QPushButton#subtle:hover   { color: @TEXT_MAIN@; background-color: @TRACK@; }
QPushButton#subtle:pressed { background-color: @BORDER@; }
QPushButton#subtle:focus   { border-color: @PRIMARY@; }
QPushButton#subtle:disabled { color: @TEXT_SUBTLE@; background-color: transparent; }

QPushButton#linkButton {
    background-color: transparent;
    color: @PRIMARY@;
    border: 1px solid transparent;
    border-radius: @RADIUS_SM@;
    padding: 2px 4px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#linkButton:hover   { color: @PRIMARY_HOVER@; }
QPushButton#linkButton:pressed { color: @PRIMARY_PRESSED@; }
QPushButton#linkButton:focus   { border-color: @PRIMARY@; }
QPushButton#linkButton:disabled { color: @TEXT_SUBTLE@; }

QFrame#panelDivider { background-color: @BORDER@; border: none; }

/* ============================================================
   INPUTS & SELECTS
   ============================================================ */
QLineEdit, QComboBox {
    background-color: @SURFACE_ALT@;
    border: 1px solid @BORDER_INPUT@;
    border-radius: @RADIUS_MD@;
    padding: 0 12px;
    font-size: 13px;
    color: @TEXT_MAIN@;
    selection-background-color: @PRIMARY_BORDER@;
    selection-color: @TEXT_MAIN@;
}
QLineEdit:hover, QComboBox:hover {
    border-color: @BORDER_HOVER@;
}
QLineEdit:focus, QComboBox:focus {
    background-color: @SURFACE@;
    border: 2px solid @PRIMARY@;
    padding: 0 11px;
}
QLineEdit[invalid="true"] {
    background-color: @FIELD_INVALID@;
    border: 1px solid @DANGER@;
}
QLineEdit[invalid="true"]:focus {
    border: 2px solid @DANGER@;
    padding: 0 11px;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: @FIELD_DISABLED@;
    color: @TEXT_SUBTLE@;
    border: 1px solid @BORDER@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 32px;
    border: none;
}
QComboBox::down-arrow {
    image: url("@GLYPH_CHEVRON@");
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:hover,
QComboBox::down-arrow:on {
    image: url("@GLYPH_CHEVRON_HOVER@");
}
QComboBox QAbstractItemView {
    background-color: @SURFACE_RAISED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: @RADIUS_SM@;
    padding: 4px;
    outline: none;
    color: @TEXT_MAIN@;
    selection-background-color: @PRIMARY_SOFT_STRONG@;
    selection-color: @TEXT_MAIN@;
}
QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 0 10px;
    border-radius: @RADIUS_SM@;
}
QComboBox QAbstractItemView::item:hover    { background-color: @TRACK@; }
QComboBox QAbstractItemView::item:selected { background-color: @PRIMARY_SOFT_STRONG@; color: @TEXT_MAIN@; }

/* ============================================================
   EVENT LOG  (rows are painted by a custom delegate)
   ============================================================ */
QListWidget#eventLog {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ============================================================
   SCROLLBARS
   ============================================================ */
QScrollArea { background: transparent; border: none; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @BORDER_STRONG@; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:vertical:hover   { background: @BORDER_HOVER@; }
QScrollBar::handle:vertical:pressed { background: @TEXT_SUBTLE@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: @BORDER_STRONG@; border-radius: 3px; min-width: 28px; }
QScrollBar::handle:horizontal:hover   { background: @BORDER_HOVER@; }
QScrollBar::handle:horizontal:pressed { background: @TEXT_SUBTLE@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
