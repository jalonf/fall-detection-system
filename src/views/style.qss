/* ============================================================
   PROFESSIONAL ENTERPRISE LIGHT THEME — Structured & Clean
   ============================================================ */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter",
                 "Roboto", "Helvetica Neue", sans-serif;
    outline: none;
}

QMainWindow,
QWidget#monitorScreen,
QWidget#monitorBody {
    background-color: #F9FAFB;
}

/* ============================================================
   AUTH SCREEN (Login/Register) — Enhanced professional gradient
   ============================================================ */
QWidget#authScreen {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0.0  #E8EEF5,
        stop: 0.5  #D4E0EF,
        stop: 1.0  #BACCDF
    );
}

QWidget#authScreen QStackedWidget,
QWidget#authPage {
    background: transparent;
}

QFrame#glassPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #D1D5DB;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QLabel#formTitle {
    font-size: 24px;
    font-weight: 800;
    color: #111827;
    letter-spacing: -0.5px;
}

QLabel#formSubtitle {
    font-size: 14px;
    font-weight: 500;
    color: #1E3A8A;
}

/* ============================================================
   MONITOR TOPBAR
   ============================================================ */
QFrame#topbar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
}

QLabel#brandMark {
    background-color: #1E3A8A;
    color: #FFFFFF;
    border-radius: 4px;
    font-size: 15px;
    font-weight: 700;
}

QLabel#avatar {
    background-color: #1E3A8A;
    color: #FFFFFF;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
}

QLabel#userName {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    background: transparent;
}

QFrame#topbarSep {
    background-color: #E5E7EB;
    border: none;
}

QFrame#statusBadgeIdle,
QFrame#statusBadgeActive,
QFrame#statusBadgeAlert {
    background: transparent;
    border: none;
    min-height: 30px;
}

/* ============================================================
   PANELS & CARDS
   ============================================================ */
QFrame#panel {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
}

QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
}

QFrame#statusCardNormal {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
}

QFrame#statusCardAlert {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 4px;
}

/* ------------------------------------------------------------
   VIDEO PANEL
   ------------------------------------------------------------ */
QLabel#videoFrame {
    background-color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    color: #9CA3AF;
}

QLabel#videoFrameAlert {
    background-color: #FEF2F2;
    border: 2px solid #DC2626;
    border-radius: 4px;
}

QLabel#videoFrameAlertDim {
    background-color: #FFF5F5;
    border: 2px solid #EF4444;
    border-radius: 4px;
}

/* ------------------------------------------------------------
   TYPOGRAPHY
   ------------------------------------------------------------ */
QLabel {
    background: transparent;
    color: #374151;
    font-size: 13px;
}

QLabel#appTitle { font-size: 16px; font-weight: 700; color: #111827; }
QLabel#appSubtitle { font-size: 11px; font-weight: 500; color: #6B7280; }
QLabel#cardTitle { font-size: 15px; font-weight: 700; color: #111827; }
QLabel#cardSubtitle { font-size: 12px; font-weight: 500; color: #6B7280; }
QLabel#fieldLabel { font-size: 12px; font-weight: 600; color: #374151; }
QLabel#sectionTitle { font-size: 10px; font-weight: 800; color: #6B7280; letter-spacing: 1px; }
QLabel#detectionDetail { font-size: 12px; color: #6B7280; font-weight: 500; }
QLabel#statLabel { font-size: 10px; font-weight: 700; color: #6B7280; letter-spacing: 0.8px; }

QFrame#divider {
    background-color: #E5E7EB;
    border: none;
    max-height: 1px;
}

/* ------------------------------------------------------------
   BUTTONS
   ------------------------------------------------------------ */
QPushButton {
    background-color: #1E3A8A;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#primary { background-color: #1E3A8A; }
QPushButton#primary:hover { background-color: #1E40AF; }
QPushButton#primary:pressed { background-color: #1E3A8A; }
QPushButton#primary:disabled { background-color: #E5E7EB; color: #9CA3AF; }

QPushButton#danger { background-color: #DC2626; }
QPushButton#danger:hover { background-color: #B91C1C; }
QPushButton#danger:pressed { background-color: #991B1B; }
QPushButton#danger:disabled { background-color: #FCA5A5; color: #FEF2F2; }

QPushButton#ghost {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    font-weight: 600;
}
QPushButton#ghost:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
    color: #111827;
}
QPushButton#ghost:pressed { background-color: #F3F4F6; }
QPushButton#ghost:disabled {
    background-color: #FFFFFF;
    color: #D1D5DB;
    border-color: #E5E7EB;
}

QPushButton#subtle {
    background-color: transparent;
    color: #6B7280;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 0 6px;
}
QPushButton#subtle:hover { color: #1E3A8A; }

/* ------------------------------------------------------------
   INPUTS
   ------------------------------------------------------------ */
QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 0 10px;
    font-size: 13px;
    color: #111827;
    selection-background-color: #BFDBFE;
    selection-color: #111827;
}
QLineEdit:hover, QComboBox:hover { border-color: #9CA3AF; }
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #1E3A8A;
    padding: 0 9px;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
    border-color: #E5E7EB;
}
QLineEdit::placeholder { color: #9CA3AF; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: #EFF6FF;
    selection-color: #111827;
}

QCheckBox {
    background: transparent;
    color: #374151;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D1D5DB;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox::indicator:hover { border-color: #1E3A8A; }
QCheckBox::indicator:checked {
    background-color: #1E3A8A;
    border-color: #1E3A8A;
}

/* ------------------------------------------------------------
   EVENT LOG
   ------------------------------------------------------------ */
QListWidget#eventLog {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 12px;
    font-weight: 500;
    outline: none;
}
QListWidget#eventLog::item {
    padding: 8px 10px;
    border-radius: 4px;
    margin-bottom: 2px;
    color: #374151;
    background-color: #FAFAFA;
    border: 1px solid #F3F4F6;
}
QListWidget#eventLog::item:hover {
    background-color: #F3F4F6;
    border-color: #E5E7EB;
}
QListWidget#eventLog::item:selected {
    background-color: #EFF6FF;
    color: #111827;
    border-color: #BFDBFE;
}

/* ------------------------------------------------------------
   SCROLLBARS
   ------------------------------------------------------------ */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 6px; margin: 2px; }
QScrollBar::handle:vertical { background: #D1D5DB; border-radius: 3px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }